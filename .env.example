PORT=5000
MONGO_URI=mongodb://localhost:27017/fitnessbyajeet
JWT_SECRET=your_jwt_secret_here

# Cloudinary (for image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# From https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Either the account auth token …
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# … or a scoped API key. The KEY must be the SK… *SID*, not the auth token.
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=your_api_key_secret
#
# The WhatsApp sender. IMPORTANT: an ordinary Twilio phone number is NOT
# WhatsApp-enabled — sending from one fails with error 63007.
#   Trial / testing → the sandbox number below, and every recipient must first
#                     WhatsApp "join <your-keyword>" to it (Console → Messaging
#                     → Try it out → Send a WhatsApp message).
#   Production      → a number registered as a WhatsApp sender (needs a paid
#                     account and Meta business verification).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: use a Messaging Service instead of a single sender (takes priority)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: approved template SID, needed to message a member more than 24 h
# after their last reply (outside the WhatsApp session window)
# TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Twilio delivery-status webhook
# TWILIO_STATUS_CALLBACK=https://your-api.vercel.app/api/webhooks/twilio
# Country code prepended to bare 10-digit numbers (91 = India)
DEFAULT_COUNTRY_CODE=91

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Brevo (Sendinblue) — recommended, works without a custom domain.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=xxxxxxxxx@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_key
# Sender members actually see. Must be a *verified sender* in Brevo — the
# @smtp-brevo.com login is a relay account, not a mailbox.
BREVO_FROM_EMAIL=you@yourdomain.com
EMAIL_FROM_NAME=FitNation by Ajeet
# EMAIL_REPLY_TO=support@yourdomain.com
#
# Any other SMTP provider (takes priority over BREVO_*):
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_smtp_password
#
# Or Gmail (EMAIL_PASS must be an App Password, not your Google password):
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your_16_char_app_password

# ── Admin alerts (new enquiries) ──────────────────────────────────────────────
# The gym's own WhatsApp number — also the number shown to members in reminders.
ADMIN_WHATSAPP_NUMBER=9174222924
ADMIN_EMAIL=owner@yourdomain.com

# ── Branding used in WhatsApp text + email template ───────────────────────────
BRAND_NAME=FITNATION BY AJEET
BRAND_COLOR=#e63946
FRONTEND_URL=https://gym-web-ten-puce.vercel.app

# ── Send throughput ───────────────────────────────────────────────────────────
# Members processed in parallel; raise carefully, Twilio rate-limits per second.
REMINDER_CONCURRENCY=5
BROADCAST_CONCURRENCY=8

# Vercel Cron secret — set this to a random string and add it in Vercel env vars too
# Vercel will send it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your_random_cron_secret_here

# CORS — comma-separated list of allowed frontend origins
# Example: https://gym-web-ten-puce.vercel.app,https://yourdomain.com
# Leave empty to allow ALL origins (local dev only)
ALLOWED_ORIGINS=https://gym-web-ten-puce.vercel.app

# ── Who the emails come from ─────────────────────────────────────────────────
# EMAIL_FROM wins over BREVO_FROM_EMAIL. It must be a sender you have VERIFIED
# in Brevo (Senders, Domains & Dedicated IPs → Senders) — Brevo rejects or
# spam-folders mail from an unverified address, so changing this alone is not
# enough. The SMTP username is separate and stays as it is.
EMAIL_FROM=admin@yourgym.com
EMAIL_FROM_NAME=FitNation by Ajeet
# Where replies land, if different from the sender.
EMAIL_REPLY_TO=admin@yourgym.com

# ── Expiry reminders ─────────────────────────────────────────────────────────
# Automatic reminders run twice a day from REMINDER_WINDOW_DAYS before expiry
# until REMINDER_GRACE_DAYS after it, then stop. Renewing ends them early.
# Chasing anyone older than the grace period is a manual decision — the
# "Send reminder" button on the Members page has no age limit.
REMINDER_WINDOW_DAYS=4
REMINDER_GRACE_DAYS=3
# The gym's local timezone. Vercel cron fires in UTC; vercel.json is set to
# 03:30 and 13:30 UTC, which is 09:00 and 19:00 in Asia/Kolkata.
REMINDER_TZ=Asia/Kolkata
