{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "node_modules/pdfkit/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fee-reminder?slot=am",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/fee-reminder?slot=pm",
      "schedule": "30 13 * * *"
    }
  ]
}
